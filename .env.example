# Copy to .env only as a reference; Spring reads these values from the process environment.
FLOOD_DB_HOST=127.0.0.1
FLOOD_DB_PORT=3306
FLOOD_DB_USERNAME=flood_app_example
FLOOD_DB_PASSWORD=replace-with-a-local-password
FLOOD_API_KEY_PEPPER=replace-with-a-long-random-pepper
FLOOD_BOOTSTRAP_ENABLED=true
FLOOD_BOOTSTRAP_CLIENT_CODE=local-example-client
FLOOD_BOOTSTRAP_API_KEY=flood_live_example1.replace_with_at_least_32_random_characters
